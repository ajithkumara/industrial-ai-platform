# ─────────────────────────────────────────────────────────────────────────────
# .env.example — copy to .env and fill in real values.
# NEVER commit .env. This file is safe to commit (no real credentials).
#
# Source all values from:
#   cd terraform/environments/dev
#   terraform output -raw eventhub_producer_connection_string
#   terraform output -raw eventhub_consumer_connection_string
#   terraform output -raw storage_account_primary_connection_string
#   terraform output -raw storage_account_name
# ─────────────────────────────────────────────────────────────────────────────

# Event Hub — producer (send-only SAS key, telemetry-sender auth rule)
# Source: terraform output -raw eventhub_producer_connection_string
EVENTHUB_CONNECTION_STRING=Endpoint=sb://<namespace>.servicebus.windows.net/;SharedAccessKeyName=telemetry-sender;SharedAccessKey=<key>;EntityPath=telemetryhub

# Event Hub name (fixed — matches Terraform resource)
EVENTHUB_NAME=telemetryhub

# Event Hub — consumer (listen-only SAS key, telemetry-reader auth rule)
# Source: terraform output -raw eventhub_consumer_connection_string
EVENTHUB_CONSUMER_CONNECTION_STRING=Endpoint=sb://<namespace>.servicebus.windows.net/;SharedAccessKeyName=telemetry-reader;SharedAccessKey=<key>;EntityPath=telemetryhub

# Consumer group ($Default is fine for dev; bronze-loader is the DLT group)
CONSUMER_GROUP=$Default

# ADLS Gen2 storage account name
# Source: terraform output -raw storage_account_name
STORAGE_ACCOUNT_NAME=<storage_account_name>

# ADLS Gen2 primary connection string (for local consumer/producer)
# Source: terraform output -raw storage_account_primary_connection_string
STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=<storage_account_name>;AccountKey=<key>;EndpointSuffix=core.windows.net

# Container / folder layout (fixed — matches Terraform)
CHECKPOINT_CONTAINER=checkpoint
RAW_CONTAINER=datalake
FILESYSTEM_NAME=datalake
RAW_FOLDER=raw/telemetry

# Batch sizes
CONSUMER_BATCH_SIZE=20
RAW_BATCH_SIZE=200
