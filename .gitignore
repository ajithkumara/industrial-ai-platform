# NOTE: .terraform.lock.hcl is intentionally NOT ignored — Terraform's own
# guidance is to commit this file so provider versions are pinned/reproducible
# across machines and CI. If it's currently tracked, keep it that way.

# Terraform generated outputs (may contain sensitive connection strings/keys)
**/outputs.json

# Local runtime state
local/checkpoints*.json

# Environment files
.env
.env.*
!.env.example

terraform/environments/dev/current-state.json
